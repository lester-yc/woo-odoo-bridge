# --- Odoo (usa el nombre del servicio en la red de docker-compose) ---
ODOO_URL=http://odoo-19:8069
ODOO_DB=postgres
ODOO_USER=admin
ODOO_PASSWORD=admin

# --- WooCommerce (URL vista desde DENTRO del contenedor -> el host) ---
WC_URL=http://host.docker.internal/tu-sitio
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Debe coincidir EXACTO con el "Secret" configurado en el webhook de WooCommerce
WC_WEBHOOK_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# --- Infra interna del microservicio ---
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite:////srv/data/bridge.db

LOG_LEVEL=INFO
